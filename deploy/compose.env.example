# Copy to deploy/.env (gitignored) and fill in. Compose reads it automatically
# when run with -f deploy/compose.yaml.

# The published image. Pin a version tag or a sha-<commit> tag for a deploy you
# can roll back; :latest follows main.
DISPLAY_MCP_IMAGE=ghcr.io/OWNER/display-mcp:latest

# Comma-separated addresses on this host for each listener, each bound as
# given. See CONTAINER.md, "Choosing the addresses". The panel has no auth;
# the MCP endpoint has none either unless the Access settings are set.
DISPLAY_MCP_PANEL_BIND=192.168.1.10,127.0.0.1
DISPLAY_MCP_PANEL_PORT=8080
DISPLAY_MCP_MCP_HOST=127.0.0.1
DISPLAY_MCP_MCP_PORT=8001

# Cloudflare Access (Zero Trust dashboard). Both empty -> authless MCP endpoint.
DISPLAY_MCP_CF_ACCESS_TEAM_DOMAIN=
DISPLAY_MCP_CF_ACCESS_AUD=
